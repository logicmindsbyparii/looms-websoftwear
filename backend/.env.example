PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/loomus_db
JWT_ACCESS_SECRET=loomus_access_secret_production_key_32bytes_min_12345
JWT_REFRESH_SECRET=loomus_refresh_secret_production_key_32bytes_min_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
IDLE_TIMEOUT_MINUTES=30

# Admin Seed Initial
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=Admin@Loomus2026!
ADMIN_SEED_NAME=Mill Administrator
ADMIN_SEED_PHONE=+91 96646 83069

# Email SMTP (optional, prints to console if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@loomus.local

# WhatsApp notification phones
WHATSAPP_ADMIN_PHONE=+91 96646 83069
WHATSAPP_GODOWN_PHONE=+91 96646 83069
WHATSAPP_SALES_PHONE=+91 96646 83069

# Meta WhatsApp Business Cloud API (Official Cloud API)
WHATSAPP_API_ENABLED=true
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=loomus_webhook_verify_token_secure_2026
