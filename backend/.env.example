PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/loomus_db
JWT_ACCESS_SECRET=loomus_access_secret_production_key_32bytes_min_12345
JWT_REFRESH_SECRET=loomus_refresh_secret_production_key_32bytes_min_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
IDLE_TIMEOUT_MINUTES=30

# Admin Seed Initial
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=Admin@Loomus2026!
ADMIN_SEED_NAME=Mill Administrator
ADMIN_SEED_PHONE=+91 75675 74107

# Email SMTP (optional, prints to console if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@loomus.local

# WhatsApp notification phones
WHATSAPP_ADMIN_PHONE=+91 75675 74107
WHATSAPP_GODOWN_PHONE=+91 75675 74107
WHATSAPP_SALES_PHONE=+91 75675 74107

# Roll QR Tracking
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_ROLL_LOOKUP=true
PUBLIC_ROLL_SHOW_LOCATION=true

# Secure Party Delivery Verification System & OTP Gateway
# Supported providers: 'fast2sms', 'twilio', 'none'
SMS_GATEWAY_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=LOOMTR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Development only: allow console simulation of receiver OTP (never enabled in production)
ALLOW_DEV_MOCK_OTP=true


